# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Experiment outputs (regenerable from code; keep the dir, ignore bulky artifacts)
results/**/*.png
results/**/*.json
!results/.gitkeep

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# LaTeX build artifacts (keep .tex/.bib/.pdf and generated tables)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.run.xml
paper/sections/*.aux
# anonymised submission build is regenerable via `make anon`
paper/main-blind.pdf

# AST 2027 build (ACM acmart) -- shares content with paper/
paper-ast/*.aux
paper-ast/*.bbl
paper-ast/*.blg
paper-ast/*.fdb_latexmk
paper-ast/*.fls
paper-ast/*.log
paper-ast/*.out
paper-ast/*.run.xml
paper-ast/main-blind.pdf
