.DS_Store
*.swp
.idea/
.vscode/

# LaTeX build artifacts (keep .tex/.bib/.pdf and generated tables)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.run.xml
paper/sections/*.aux
